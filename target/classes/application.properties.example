# Example template for application.properties
spring.application.name=digital-forensics-system
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/cyber_forensics_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
app.forensics.storage.vault-dir=./evidence-vault
